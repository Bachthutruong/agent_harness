{
  "name": "agent-harness",
  "version": "1.0.0",
  "description": "Harness cho AI coding agent: sáu thành phần chạy được, kèm demo một lần chạy thật",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "test": "node harness/03-gate/gate.js",
    "gate": "node harness/03-gate/gate.js",
    "check-all": "bash harness/03-gate/check-all.sh",
    "verify": "node harness/04-verify/verify.js",
    "budget": "node harness/06-budget/budget.js --seconds 30 --tries 2 -- npm test",
    "try-run-A": "node harness/03-gate/gate.js --task cart --file demo/recorded-2026-11-08/cart-run-A.js --fn tinhTien",
    "try-run-B": "node harness/03-gate/gate.js --task cart --file demo/recorded-2026-11-08/cart-run-B.js --fn tinhTien",
    "try:without": "bash demo/setup-try.sh without",
    "try:with": "bash demo/setup-try.sh with",
    "demo": "bash demo/replay.sh",
    "demo:live": "bash demo/run-live.sh"
  }
}
